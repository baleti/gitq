#compdef gitq
# zsh completion for the gitq pipeline CLI tool.
#
# Install: `make install-zsh` in the repo root (copies this file into
# ${XDG_DATA_HOME:-~/.local/share}/zsh/completions), or copy/symlink it
# into any directory on your $fpath yourself. Then in ~/.zshrc, before
# compinit:
#   fpath=(~/.local/share/zsh/completions $fpath)
#   autoload -Uz compinit && compinit
#
# How it works:
#   gitq takes its entire pipeline as a single string argument, so completion
#   happens *within* that argument.  We split the typed prefix on whitespace,
#   set IPREFIX to everything before the last (partial) word, and delegate
#   candidate generation to `gitq --complete PREFIX` which prints one candidate
#   per line.  This way the completion logic lives in the gitq binary itself
#   and is shared with the Emacs integration.

# Work out what to complete, from the words before the cursor and the
# partial word under it.
#
# gitq accepts its pipeline either as one quoted argument
# (`gitq 'commits wh<TAB>'`) or as plain unquoted words
# (`gitq commits wh<TAB>`) — main.rs simply joins argv with spaces.  Only
# the quoted form used to complete, because this function bailed out unless
# the cursor was on argument 2; `gitq commits <TAB>` sat on argument 3 and
# silently did nothing.
#
# Sets three globals, so it can be tested without a completion system:
#   _gitq_head     already-complete pipeline text, with a trailing space
#   _gitq_partial  the token being completed
#   _gitq_inword   the part of the CURRENT word that precedes the token
#                  (an opening quote, and any earlier tokens sharing the
#                  word) — this is what has to move into IPREFIX
_gitq_compute_prefix() {
  local -a prior
  prior=("${(@)words[2,CURRENT-1]}")

  # Words completed in earlier argv positions (the unquoted form).  Strip a
  # wrapping quote from each so gitq's tokenizer sees the pipeline itself.
  local w head=""
  for w in "${prior[@]}"; do
    w="${w#[\"\']}"
    w="${w%[\"\']}"
    [[ -n "$w" ]] && head+="$w "
  done

  # Now split the current word.  In the quoted form this holds the whole
  # pipeline typed so far; in the unquoted form it is just one token.
  local cur="$PREFIX" qlead=""
  case "$cur" in
    \'*) qlead="'"; cur="${cur#\'}" ;;
    \"*) qlead='"'; cur="${cur#\"}" ;;
  esac

  local -a typed
  typed=("${(z)cur}")               # (z) splits respecting shell quoting

  local partial="" inword=""
  if (( ${#typed[@]} > 0 )); then
    # A trailing space means the last token is finished and we are starting
    # a new, empty one.
    if [[ "$cur" == *[[:space:]] ]]; then
      inword="$cur"
    else
      partial="${typed[-1]}"
      if (( ${#typed[@]} > 1 )); then
        typed[-1]=()
        inword="${(j: :)typed} "
      fi
    fi
  fi

  _gitq_head="$head"
  _gitq_partial="$partial"
  _gitq_inword="$qlead$inword"
  _gitq_full="$head$inword$partial"
}

_gitq() {
  # Only the pipeline is completed; there are no other arguments.
  (( CURRENT < 2 )) && return 1

  local _gitq_head _gitq_partial _gitq_inword _gitq_full
  _gitq_compute_prefix

  # Tell zsh that IPREFIX (the non-completing prefix) is everything before
  # the token, and PREFIX (the part being replaced) is the token itself.
  IPREFIX+="$_gitq_inword"
  PREFIX="$_gitq_partial"
  SUFFIX=""

  # fzf-tab (optional): show gitq's completion with a live preview of the
  # pipeline each candidate would produce — the terminal counterpart of
  # gitq.el's live preview.  Scoped to :gitq: so nothing else is touched, a
  # no-op when fzf-tab isn't installed, and self-registered here (not in
  # ~/.zshrc) so the preview re-bakes the pipeline-so-far every call; the
  # highlighted candidate ($word) is appended at preview time.
  #
  # fzf-command/fzf-flags are pinned for this context specifically, which
  # shadows any global ':fzf-tab:*' settings for gitq (zstyle uses the most
  # specific matching context).  fzf-command=fzf keeps completion in fzf's
  # own pane rather than a tmux popup — no tmux dependency, and the tmux
  # prefix key keeps working while completing.  The explicit fzf-flags drop
  # a global '--no-preview' (common in fzf-tab setups) that would otherwise
  # suppress the preview window.  Tune the geometry to taste.
  local _gitq_pre="${_gitq_full%$_gitq_partial}"
  zstyle ':fzf-tab:complete:gitq:*' fzf-preview "gitq --preview ${(q)_gitq_pre}\$word 2>&1"
  zstyle ':fzf-tab:complete:gitq:*' fzf-command fzf
  zstyle ':fzf-tab:complete:gitq:*' fzf-flags --height=80% --preview-window=right:60%:wrap

  # Ask gitq for candidates given everything typed so far.
  local full_prefix="$_gitq_full"
  local -a annotated
  annotated=(${(f)"$(gitq --complete-annotated "$full_prefix" 2>/dev/null)"})

  if [[ ${#annotated[@]} -eq 0 ]]; then
    return 1
  fi

  # Group candidates by kind for a nicer completion menu.
  #
  # The kind comes from `gitq --complete-annotated`, which prints
  # "candidate<TAB>kind<TAB>description" — the same registry the parser and
  # the Emacs client use.  This file used to carry its own copies of the
  # source/step/morphism/field/operator lists, which is exactly the drift
  # the registry exists to prevent: they had already fallen behind on
  # `parent†` and `tree.entries[Blob]`, and would have missed `hunks`.
  local -a src_cands step_cands term_cands morph_cands field_cands op_cands other_cands
  local line c kind
  for line in $annotated; do
    c="${line%%$'\t'*}"
    kind="${${line#*$'\t'}%%$'\t'*}"
    case "$kind" in
      source)   src_cands+=("$c")   ;;
      step)     step_cands+=("$c")  ;;
      morphism) morph_cands+=("$c") ;;
      field)    field_cands+=("$c") ;;
      operator) op_cands+=("$c")    ;;
      terminal) term_cands+=("$c")  ;;
      # dynamic values (author names, shas, refs) have no registry kind
      *)        other_cands+=("$c") ;;
    esac
  done

  local expl
  [[ ${#src_cands[@]}   -gt 0 ]] && { _description gitq-src   expl 'source';    compadd "$expl[@]" -- $src_cands   }
  [[ ${#step_cands[@]}  -gt 0 ]] && { _description gitq-step  expl 'step';      compadd "$expl[@]" -- $step_cands  }
  [[ ${#morph_cands[@]} -gt 0 ]] && { _description gitq-morph expl 'morphism';  compadd "$expl[@]" -- $morph_cands }
  [[ ${#field_cands[@]} -gt 0 ]] && { _description gitq-field expl 'field';     compadd "$expl[@]" -- $field_cands }
  [[ ${#op_cands[@]}    -gt 0 ]] && { _description gitq-op    expl 'operator';  compadd "$expl[@]" -- $op_cands    }
  [[ ${#term_cands[@]}  -gt 0 ]] && { _description gitq-term  expl '/terminal'; compadd "$expl[@]" -- $term_cands  }
  [[ ${#other_cands[@]} -gt 0 ]] && { _description gitq-other expl 'value';     compadd "$expl[@]" -- $other_cands }
}

_gitq "$@"
